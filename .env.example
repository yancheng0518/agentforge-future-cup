# Copy to .env in the project root. Never commit real secrets.
# Use the exact enabled model ID from the competition platform.
AGENTFORGE_LLM_BASE_URL=https://aigw.omniedu.com/v1
AGENTFORGE_LLM_MODEL=
AGENTFORGE_LLM_API_KEY=
AGENTFORGE_LLM_TIMEOUT=60
# Minimum gap between model request starts (seconds), shared across local runs.
AGENTFORGE_LLM_MIN_INTERVAL=4.2
AGENTFORGE_TEST_IMAGE=agentforge-test:py313
# native: Docker CLI; wsl: Docker Engine inside the dedicated Linux distro.
AGENTFORGE_DOCKER_BACKEND=native
AGENTFORGE_WSL_DISTRO=AgentForge
